
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <mouse-gesture.dtsi>
#include <dt-bindings/zmk/mouse-gesture.h>

/ {
    pmw3610_scroll_scaler: pmw3610_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&zip_mouse_gesture {
    enable-eager-mode;
    stroke-size = <150>;          // 1回のジェスチャーと認識される移動量の閾値(既定200 → 少し短めにして反応させやすくする)
    gesture-cooldown-ms = <200>;  // 連続発火を許可する間隔(既定500 → 短くする)。長く振ると閾値を複数回超えてタブが連続で切り替わり、短く振ると1回だけになる、という挙動を狙う

    prev_tab {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LC(LS(TAB))>;  // Ctrl+Shift+Tab (Chromeで左のタブへ)
    };

    next_tab {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LC(TAB)>;      // Ctrl+Tab (Chromeで右のタブへ)
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;

    trackball: pointing_device: pointing_device@0 {
        status = "okay";
        compatible = "pixart,pmw3610-alt";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <800>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        force-awake;
    };
};

&zip_temp_layer {
    require-prior-idle-ms = <200>;
};

&pointing_listener {
    input-processors =
        <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP)>,
        <&zip_y_scaler 6 5>,
        <&zip_temp_layer 1 500>;

    scroller {
        layers = <2>;
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT)>,
            <&zip_x_scaler 0 1>,
            <&zip_xy_to_scroll_mapper>,
            <&pmw3610_scroll_scaler 1 20>;
        process-next;
    };

    hscroller {
        layers = <6>;
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT)>,
            <&zip_y_scaler 0 1>,
            <&zip_xy_to_scroll_mapper>,
            <&pmw3610_scroll_scaler 1 20>;
        process-next;
    };

    gesture {
        layers = <5>;
        input-processors = <&zip_mouse_gesture>;
    };
};
