
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <mouse-gesture.dtsi>
#include <dt-bindings/zmk/mouse-gesture.h>

/ {
    pmw3610_scroll_scaler: pmw3610_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };

    // レイヤー7用のジェスチャー設定。SQTキーのホールドでCmdが押しっぱなしに
    // なる仕組み(keymap.keymap側のcmd_layer7マクロ)と組み合わせて使うため、
    // ここでは素のTAB/Shift+TABを送り、Cmd+Tab/Cmd+Shift+Tabとして機能させる
    layer7_gesture: layer7_gesture {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        enable-eager-mode;
        always-active;
        suppress-movement;
        stroke-size = <200>;
        gesture-cooldown-ms = <150>;

        next_tab {
            pattern = <GESTURE_RIGHT>;
            bindings = <&kp TAB>;       // Tab (Cmdと合わさってCmd+Tab)
        };
        prev_tab {
            pattern = <GESTURE_LEFT>;
            bindings = <&kp LS(TAB)>;   // Shift+Tab (Cmdと合わさってCmd+Shift+Tab)
        };
    };

    // レイヤー4用のジェスチャー設定(アプリ切り替え、左右のみ)。
    // オプションはレイヤー5のタブ切り替えジェスチャー(zip_mouse_gesture)と全て同じ
    layer4_gesture: layer4_gesture {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        enable-eager-mode;
        always-active;
        suppress-movement;
        stroke-size = <100>;
        gesture-cooldown-ms = <120>;

        prev_app {
            pattern = <GESTURE_LEFT>;
            bindings = <&kp LG(LS(TAB))>;  // Cmd+Shift+Tab (前のアプリへ)
        };
        next_app {
            pattern = <GESTURE_RIGHT>;
            bindings = <&kp LG(TAB)>;      // Cmd+Tab (次のアプリへ)
        };
    };

    // レイヤー3用のジェスチャー設定(左右のみ)
    layer3_gesture: layer3_gesture {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        enable-eager-mode;
        always-active;
        suppress-movement;
        // 左右2方向だけなので既定値(200)のままで問題ない
        // gesture-cooldown-msは指定せず既定値(500ms)のまま

        move_left {
            pattern = <GESTURE_LEFT>;
            bindings = <&kp LG(LEFT_ARROW)>;   // Cmd+←
        };
        move_right {
            pattern = <GESTURE_RIGHT>;
            bindings = <&kp LG(RIGHT_ARROW)>;  // Cmd+→
        };
    };
};

&zip_mouse_gesture {
    enable-eager-mode;
    always-active;                // レイヤー5に入っている間、起動キーなしで自動的にジェスチャー認識をONにする
    suppress-movement;            // ジェスチャー中はカーソルを動かさない(素通しでマウスが動いてしまうのを防ぐ)
    stroke-size = <100>;           // 1回のジェスチャーと認識される移動量の閾値。小さくするほど、長くスーッと動かした時に短い距離で連続して切り替わるようになる
    gesture-cooldown-ms = <120>;   // 連続発火を許可する最短間隔(時間ベース)。スーッと動かした時にこの時間が経つまで次の発動をブロックしてしまうため、stroke-sizeだけでなくこちらも短縮。ただしシャッ!という一瞬の動き全体はこれより短い時間で終わる想定のため、1回しか発動しない挙動は維持されるはず

    prev_tab {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LC(LS(TAB))>;  // Ctrl+Shift+Tab (Chromeで左のタブへ)
    };

    next_tab {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LC(TAB)>;      // Ctrl+Tab (Chromeで右のタブへ)
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;

    trackball: pointing_device: pointing_device@0 {
        status = "okay";
        compatible = "pixart,pmw3610-alt";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <800>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        force-awake;
    };
};

&zip_temp_layer {
    require-prior-idle-ms = <200>;
};

&pointing_listener {
    input-processors =
        <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP)>,
        <&zip_y_scaler 6 5>,
        <&zip_temp_layer 1 500>;

    scroller {
        layers = <2>;
        input-processors =
            // XY_SWAPを外すことで、センサーの生のY軸(=物理的な左右方向の動き)を
            // 縦スクロールの入力として使う。Y_INVERTを外して向きを反転する
            <&zip_x_scaler 0 1>,
            <&zip_xy_to_scroll_mapper>,
            <&pmw3610_scroll_scaler 1 30>;  // 感度を1/20倍から1/30倍にさらに落とす
        process-next;
    };

    hscroller {
        layers = <6>;
        input-processors =
            // XY_SWAPを追加することで、センサーの生のY軸(=物理的な左右方向の動き)を
            // 横スクロールの入力として使う。X_INVERTを追加して向きを反転する
            <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)>,
            <&zip_y_scaler 0 1>,
            <&zip_xy_to_scroll_mapper>,
            <&pmw3610_scroll_scaler 1 40>;  // 縦スクロール(1/30倍)の3/4倍(=3/120=1/40倍)を維持したまま感度を落とす
        process-next;
    };

    gesture {
        layers = <5>;
        input-processors =
            // 通常のカーソル移動と同じXY_SWAP補正をかけてから渡すことで、
            // 物理的な左右の動きがジェスチャー判定の「左右」と一致するようにする
            <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP)>,
            <&zip_mouse_gesture>;
    };

    gesture_layer4 {
        layers = <4>;
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP)>,
            <&layer4_gesture>;
    };

    gesture_layer7 {
        layers = <7>;
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP)>,
            <&layer7_gesture>;
    };

    gesture_layer3 {
        layers = <3>;
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP)>,
            <&layer3_gesture>;
    };
};
