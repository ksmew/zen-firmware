#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <4 3>;
        };

        page_back {
            bindings = <&kp LG(LEFT_ARROW)>;
            key-positions = <14 15>;
        };

        page_forward {
            bindings = <&kp RG(RIGHT_ARROW)>;
            key-positions = <20 21>;
        };
    };

    macros {
        lclk_to0: lclk_to0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp LCLK &to 0>;
            label = "LCLK_TO0";
        };

        rclk_to0: rclk_to0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp RCLK &to 0>;
            label = "RCLK_TO0";
        };

        copy1row: select1row {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(LEFT_ARROW) &kp RG(RS(RIGHT_ARROW)) &kp RG(C)>;
            label = "SELECT1ROW";
        };

        deleteAll: allDelete {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(A) &kp BACKSPACE>;
            label = "ALLDELETE";
        };

        copyAll: copyAll {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(A) &kp RG(C)>;
            label = "COPYALL";
        };

        copyBelow: copyBelow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(LEFT_ARROW) &kp RG(RS(DOWN_ARROW)) &kp RG(C)>;
            label = "COPYBELOW";
        };
    };

    behaviors {
        screenshot: screenshot {
            compatible = "zmk,behavior-tap-dance";
            label = "SCREENSHOT";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(N5))>, <&kp LG(LS(NUMBER_4))>;

            tapping-term-ms = <150>;
        };

        window_right: window_right {
            compatible = "zmk,behavior-tap-dance";
            label = "WINDOW_RIGHT";
            #binding-cells = <0>;
            bindings = <&kp RA(RG(RIGHT_ARROW))>, <&kp RA(RG(UP_ARROW))>;

            tapping-term-ms = <150>;
        };

        window_left: window_left {
            compatible = "zmk,behavior-tap-dance";
            label = "WINDOW_LEFT";
            #binding-cells = <0>;
            bindings = <&kp LA(LG(LEFT_ARROW))>, <&kp LA(LG(DOWN_ARROW))>;

            tapping-term-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESCAPE            &kp Q          &kp W          &kp E             &kp R           &kp T        &kp Y                 &kp U                  &kp I            &kp O      &kp P        &deleteAll
&mt LEFT_CONTROL TAB  &lt 4 A        &kp S          &mt LEFT_ALT D    &mt LEFT_GUI F  &kp G        &kp H                 &mt RIGHT_GUI J        &mt RIGHT_ALT K  &kp L      &lt 3 MINUS  &kp BACKSPACE
&kp AT_SIGN           &kp Z          &kp X          &kp C             &kp V           &kp B        &window_left          &window_right          &kp N            &kp M      &kp COMMA    &mt RIGHT_GUI DOT  &kp SLASH  &kp EXCLAMATION
&screenshot           &kp LG(LA(N))  &kp LG(LS(N))  &kp LC(UP_ARROW)  &lt 5 ENTER     &lt 2 SPACE  &mt LEFT_SHIFT LANG2  &mt RIGHT_SHIFT LANG1  &copyAll         &copy1row  &copyBelow   &kp RG(SPACE)
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans              &trans               &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &mkp RCLK  &mkp LCLK  &kp LG(LEFT_ARROW)  &kp RG(RIGHT_ARROW)  &mkp LCLK  &mkp LCLK  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans              &trans               &trans     &trans     &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans              &trans               &trans     &trans     &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &kp SLASH       &kp ASTERISK  &kp MINUS  &kp PLUS    &trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans        &trans
&trans  &kp LEFT_SHIFT  &kp PERCENT   &kp COMMA  &kp PERIOD  &trans  &trans  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL     &kp BACKSPACE
&trans  &kp LEFT_SHIFT  &trans        &trans     &trans      &trans  &trans  &trans        &trans        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9   &trans  &trans
&trans  &trans          &trans        &trans     &trans      &trans  &trans  &kp NUMBER_0  &trans        &trans        &trans        &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &kp F3   &kp F2   &kp F1   &trans  &trans  &trans  &trans  &trans             &trans      &kp DELETE
&trans  &trans  &kp F6   &kp F5   &kp F4   &trans  &trans  &trans  &trans  &trans             &trans      &trans
&trans  &trans  &kp F9   &kp F8   &kp F7   &trans  &trans  &trans  &trans  &trans             &trans      &trans           &trans  &trans
&trans  &trans  &kp F12  &kp F11  &kp F10  &trans  &trans  &trans  &trans  &kp C_VOLUME_DOWN  &kp K_MUTE  &kp C_VOLUME_UP
            >;
        };

        layer_4 {
            bindings = <
&bt BT_CLR  &trans  &trans  &trans  &trans  &trans  &kp DOLLAR    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp TILDE         &kp PIPE           &trans
&trans      &trans  &trans  &trans  &trans  &trans  &kp HASH      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON     &kp COLON          &trans
&trans      &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 2          &kp AMPERSAND          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SQT  &kp DOUBLE_QUOTES  &trans
&trans      &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 1  &bt BT_SEL 3          &trans                 &trans            &trans             &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &kp RS(LEFT_ARROW)  &kp RS(DOWN_ARROW)  &kp RS(UP_ARROW)  &kp RS(RIGHT_ARROW)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT_ARROW      &kp DOWN_ARROW      &kp UP_ARROW      &kp RIGHT_ARROW      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans              &trans              &trans            &trans               &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans              &trans              &trans            &trans               &trans  &trans
            >;
        };
    };
};
