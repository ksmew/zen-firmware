#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESCAPE             &kp Q         &kp W         &kp E          &kp R        &kp T      &kp Y           &kp U            &kp I            &kp O           &kp P           &kp BSPC
&mt LEFT_CONTROL TAB   &kp A         &kp S         &kp D          &kp F        &kp G      &kp H           &kp J            &kp K            &kp L           &kp MINUS       &kp ENTER
&mt LSHFT EXCLAMATION  &kp Z         &kp X         &kp C          &kp V        &kp B      &msc SCRL_LEFT  &msc SCRL_RIGHT  &kp N            &kp M           &kp COMMA       &mt RIGHT_GUI DOT  &kp UP_ARROW  &mt RSHFT QUESTION
&mo 2                  &kp LEFT_ALT  &kp LEFT_GUI  &lt 4 AT_SIGN  &lt 1 SPACE  &kp LANG2  &msc SCRL_DOWN  &msc SCRL_UP     &lt 3 RG(SPACE)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                &mkp LCLK  &mo 3             &mkp RCLK  &trans                 &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp RG(LEFT_BRACKET)  &mkp MB1   &mkp MB3          &mkp MB2   &kp RG(RIGHT_BRACKET)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                &trans     &kp LC(UP_ARROW)  &trans     &trans                 &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                &trans     &trans            &trans     &trans                 &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &kp EQUAL    &kp PLUS      &kp MINUS     &kp ASTERISK  &kp SLASH     &kp BACKSPACE
&trans  &trans  &trans  &trans  &trans  &trans  &kp PERCENT  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5
&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans        &trans        &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8   &kp NUMBER_9  &kp NUMBER_0
&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans        &trans        &trans        &trans        &trans
            >;
        };

        layer_3 {
            bindings = <
&trans   &trans  &trans  &trans   &trans   &trans  &trans  &trans  &trans  &trans             &trans      &kp DELETE
&kp F5   &kp F4  &kp F3  &kp F2   &kp F1   &trans  &trans  &trans  &trans  &trans             &trans      &trans
&kp F10  &kp F9  &kp F8  &kp F7   &kp F6   &trans  &trans  &trans  &trans  &trans             &trans      &trans           &trans  &trans
&trans   &trans  &trans  &kp F12  &kp F11  &trans  &trans  &trans  &trans  &kp C_VOLUME_DOWN  &kp K_MUTE  &kp C_VOLUME_UP
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp TILDE         &kp PIPE           &kp BACKSPACE
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON     &kp COLON          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                &trans                 &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SQT        &kp DOUBLE_QUOTES  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                &kp HASH               &kp DOLLAR        &kp PERCENT        &kp AMPERSAND
            >;
        };
    };
};
